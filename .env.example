# Required for live LinkedIn data. Create a key at https://app.monid.ai/access/api-keys
MONID_API_KEY=

# Defaults can be changed after inspecting the current Monid catalog.
MONID_PROFILE_PROVIDER=tikhub
MONID_PROFILE_ENDPOINT=/api/v1/linkedin/web_v2/get_user_profile
MONID_POSTS_PROVIDER=tikhub
MONID_POSTS_ENDPOINT=/api/v1/linkedin/web_v2/get_user_posts

# Optional. Defaults to ./data/linkedin-tracker.json.
TRACKER_DATA_FILE=./data/linkedin-tracker.json
